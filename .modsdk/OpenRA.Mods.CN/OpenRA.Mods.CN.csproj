<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EngineRootPath>../engine</EngineRootPath>
  </PropertyGroup>
  <Import Project="../engine/Directory.Build.props" />
  <ItemGroup>
    <!-- SA0001 is spuriously reported when the engine projects are rebuilt through this external
      mod project. Their Debug builds already enable GenerateDocumentationFile. -->
    <ProjectReference Include="$(EngineRootPath)/OpenRA.Game/OpenRA.Game.csproj" AdditionalProperties="NoWarn=SA0001">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="$(EngineRootPath)/OpenRA.Mods.Cnc/OpenRA.Mods.Cnc.csproj" AdditionalProperties="NoWarn=SA0001">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="$(EngineRootPath)/OpenRA.Mods.Common/OpenRA.Mods.Common.csproj" AdditionalProperties="NoWarn=SA0001">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
