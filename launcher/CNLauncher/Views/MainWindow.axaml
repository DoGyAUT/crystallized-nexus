<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CNLauncher.ViewModels"
        xmlns:v="using:CNLauncher.Views"
        x:Class="CNLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Crystallized Nexus"
        Width="820" Height="560"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Shell}"
        Icon="avares://CNLauncher/Assets/logo.png">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PanelHi}" />
      <Setter Property="TextBlock.Foreground" Value="{StaticResource Text}" />
    </Style>
    <!-- The Fluent default paints disabled buttons as filled boxes, which makes a row of
         plain text links look broken; unavailable actions just dim instead. -->
    <Style Selector="Button.link:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#4C565F" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#0C1207" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Padding" Value="40,14" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PanelHi}" />
      <Setter Property="TextBlock.Foreground" Value="{StaticResource Muted}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="24,18"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Source="avares://CNLauncher/Assets/logo.png"
               Width="52" Height="52" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="CRYSTALLIZED NEXUS" FontSize="22" FontWeight="Bold"
                     LetterSpacing="3" Foreground="{StaticResource Text}" />
          <TextBlock Text="A reimagining of Crystallized Doom, built on OpenRA"
                     FontSize="12" Foreground="{StaticResource Muted}" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
          <TextBlock Text="{Binding LauncherVersionText}" FontSize="11"
                     HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
          <ComboBox SelectedIndex="{Binding SelectedChannelIndex}" MinWidth="180" FontSize="12">
            <ComboBoxItem Content="Stable builds" />
            <ComboBoxItem Content="Playtest builds" />
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="*,300" Margin="24,20,24,0">

      <!-- Release notes -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6"
              BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Classes="label" Text="WHAT'S NEW" Margin="0,0,0,10" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding ReleaseNotes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReleaseNote">
                  <StackPanel Margin="0,0,0,20" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <!-- Builds published after the installed one are what the player has
                           not read yet, so the accent marks how far back to scroll. -->
                      <Border Width="3" CornerRadius="2"
                              Background="{StaticResource Accent}"
                              IsVisible="{Binding IsUnread}" />
                      <TextBlock Text="{Binding Tag}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource Text}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="11,0,0,4"
                               Foreground="{StaticResource Muted}"
                               IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock v:MarkdownText.Text="{Binding Body}" TextWrapping="Wrap" Margin="11,0,0,0"
                               FontSize="13" LineHeight="20" Foreground="{StaticResource Text}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Info panel -->
      <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="14">
        <StackPanel Spacing="3">
          <TextBlock Classes="label" Text="INSTALLED" />
          <TextBlock Classes="value" Text="{Binding InstalledVersion}" />
        </StackPanel>

        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="label" Text="BUILD" VerticalAlignment="Center" />
            <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="5,1"
                    IsVisible="{Binding UpdateAvailable}">
              <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="#0C1207" />
            </Border>
          </StackPanel>
          <!-- "Latest" follows the channel; picking a tag pins it, which is how a tester
               drops back to an earlier build to find where a problem started. -->
          <ComboBox ItemsSource="{Binding Builds}"
                    SelectedIndex="{Binding SelectedBuildIndex}"
                    HorizontalAlignment="Stretch" FontSize="12" MaxDropDownHeight="260">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BuildOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Classes="label" Text="INSTALL FOLDER" />
          <TextBlock Text="{Binding InstallPathText}" FontSize="11" TextWrapping="Wrap"
                     MaxLines="3" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource Muted}" />
          <StackPanel Orientation="Horizontal" Margin="-8,2,0,0">
            <Button Classes="link" Content="Open" Command="{Binding OpenInstallDirCommand}" />
            <Button Classes="link" Content="Change..." Command="{Binding ChangeInstallDirCommand}" />
          </StackPanel>
        </StackPanel>

        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="12,10"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="GAME ASSETS" />
            <TextBlock Text="{Binding ContentStatus}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Footer -->
    <StackPanel Grid.Row="2" Margin="24,16,24,20" Spacing="12">

      <StackPanel Spacing="6" IsVisible="{Binding ShowProgress}">
        <ProgressBar Minimum="0" Maximum="100" Height="6"
                     Value="{Binding ProgressValue}"
                     IsIndeterminate="{Binding ProgressIndeterminate}"
                     Foreground="{StaticResource Accent}"
                     Background="{StaticResource PanelHi}" />
        <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Right"
                   Foreground="{StaticResource Muted}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap"
                     Foreground="{StaticResource Text}" />
          <StackPanel Orientation="Horizontal" Margin="-8,0,0,0">
            <Button Classes="link" Content="Discord" Command="{Binding DiscordCommand}" />
            <Button Classes="link" Content="All releases" Command="{Binding ReleasesPageCommand}" />
            <Button Classes="link" Content="Logs" Command="{Binding OpenLogsCommand}" />
            <Button Classes="link" Content="Bug report zip" Command="{Binding CollectLogsCommand}" />
            <Button Classes="link" Content="Reinstall" Command="{Binding RepairCommand}" />
            <Button Classes="link" Content="Uninstall" Command="{Binding UninstallCommand}" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="1" Classes="primary" MinWidth="200"
                Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
